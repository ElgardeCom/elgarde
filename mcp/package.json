    "vehicle-inspection",
    "used-car",
    "pre-purchase-inspection",
    "automotive",
    "vin"
  ],
  "homepage": "https://elgarde.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ElgardeCom/elgarde.git",
    "directory": "mcp"
  },
  "bugs": "https://github.com/ElgardeCom/elgarde/issues",
  "author": "Elgarde <support@elgarde.com> (https://elgarde.com)",
  "license": "MIT",
  "type": "module",
  "main": "server.js",
  "bin": {
    "elgarde-mcp": "bin/elgarde-mcp.js",
    "elgarde-mcp-http": "bin/elgarde-mcp-http.js"
  },
  "files": [
    "server.js",
    "bin/",
    "http.js",
    "README.md",
    "LICENSE"
  ],
